# Copy to .env and edit:  cp .env.example .env
APP_PORT=3000
API_PORT=4000
DB_PORT=5433

POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker

# Use a long random value, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# true = create demo account demo@example.com / demo12345 with sample November 2026 data
SEED_DEMO=true
